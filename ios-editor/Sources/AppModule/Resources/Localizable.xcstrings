    "Clear": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dọn"
          }
        }
      }
    },
    "Cache and downloaded templates are made again when needed, so clearing them is safe. Your media is not removed here.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ đệm và mẫu đã tải sẽ được tạo lại khi cần nên dọn chúng là an toàn. Media của bạn không bị xóa ở đây."
          }
        }
      }
    },
    "Cache and downloaded templates are made again when needed. Templates you own stay yours. Your media is not removed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ đệm và mẫu đã tải sẽ được tạo lại khi cần. Các mẫu bạn đã mua vẫn thuộc về bạn. Media của bạn không bị xóa."
          }
        }
      }
    },
    "Cache is made again when needed. Your media is not removed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ đệm sẽ được tạo lại khi cần. Media của bạn không bị xóa."
          }
        }
      }
    }
  },
  "version": "1.0"
