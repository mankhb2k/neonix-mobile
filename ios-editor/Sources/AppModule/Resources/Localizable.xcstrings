            "state": "translated",
            "value": "Không khả dụng"
          }
        }
      }
    },
    "The purchase didn't go through. If you were charged, your credits will arrive shortly.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch chưa hoàn tất. Nếu bạn đã bị trừ tiền, credit sẽ sớm được cộng."
          }
        }
      }
    },
    "Your purchase is waiting for approval.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch của bạn đang chờ phê duyệt."
          }
        }
      }
    },
