{
  "format": "motion-protocol",
  "formatVersion": 2,
  "id": "fade-out-demo",
  "composition": { "width": 320, "height": 320, "fps": 30, "background": "#101820", "colorSpace": "srgb" },
  "assets": [],
  "layers": [
    {
      "id": "card",
      "parentLayerId": null,
      "order": 0,
      "frame": { "width": 160, "height": 160 },
      "transform": {
        "translate": { "x": 0, "y": 0, "z": 0 },
        "scale": { "x": 1, "y": 1, "z": 1 },
        "rotate": { "x": 0, "y": 0, "z": 0 },
        "skew": { "x": 0, "y": 0 },
        "anchor": { "x": 0, "y": 0, "z": 0 }
      },
      "opacity": 1,
      "timing": { "start": 0, "duration": 2000 },
      "type": "shape",
      "payload": { "shape": "rectangle" },
      "style": { "fill": "#14B8A6" },
      "tracks": [
        {
          "id": "fade-out",
          "path": "opacity",
          "keyframes": [
            { "time": { "anchor": "end", "offsetMs": 300 }, "value": { "type": "number", "value": 1 } },
            { "time": { "anchor": "end", "offsetMs": 0 }, "value": { "type": "number", "value": 0 } }
          ]
        }
      ]
    }
  ],
  "audio": { "sampleRate": 48000, "tracks": [] }
}
